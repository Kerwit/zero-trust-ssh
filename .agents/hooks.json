{
  "blast-governance": {
    "PreToolUse": [
      {
        "matcher": "edit_file|write_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/blast-gemini-hook-adapter.sh blast-require-search.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "./hooks/blast-gemini-hook-adapter.sh blast-require-plan-schema.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "./hooks/blast-gemini-hook-adapter.sh blast-require-clear.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "./hooks/blast-gemini-hook-adapter.sh blast-ui-check.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/blast-gemini-hook-adapter.sh blast-require-clear.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command|bash|execute_command|grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/blast-gemini-hook-adapter.sh blast-no-raw-search.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "./hooks/blast-gemini-hook-adapter.sh blast-require-thread.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "./hooks/blast-gemini-hook-adapter.sh blast-require-rtk.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "./hooks/blast-gemini-hook-adapter.sh blast-watch-start.sh",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "./hooks/blast-gemini-hook-adapter.sh blast-version-check.sh",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/blast-gemini-hook-adapter.sh blast-goal-stop.sh",
        "timeout": 120
      },
      {
        "type": "command",
        "command": "./hooks/blast-gemini-hook-adapter.sh blast-watch-stop.sh",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "./hooks/blast-gemini-hook-adapter.sh blast-telemetry-upload.sh",
        "timeout": 60
      }
    ]
  }
}
